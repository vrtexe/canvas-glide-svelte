{
  "name": "@canvas-glide/svelte",
  "version": "1.0.2",
  "description": "Svelte 5 components and attachment for canvas-glide: pan, zoom and pinch-to-zoom for images or any content, with reactive state and mouse, touch, pen and wheel input.",
  "keywords": [
    "svelte",
    "svelte5",
    "sveltekit",
    "runes",
    "svelte-attachment",
    "svelte-library",
    "pan-zoom",
    "panzoom",
    "pinch-zoom",
    "pinch-to-zoom",
    "zoom",
    "pan",
    "image-viewer",
    "image-zoom",
    "canvas",
    "gestures",
    "touch",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://github.com/vrtexe/canvas-glide-svelte#readme",
  "bugs": {
    "url": "https://github.com/vrtexe/canvas-glide-svelte/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vrtexe/canvas-glide-svelte.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "svelte-package -i src/lib -o dist && publint",
    "build:demo": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run"
  },
  "dependencies": {
    "canvas-glide": "^1.0.1"
  },
  "peerDependencies": {
    "svelte": "^5.29.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^3.0.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "jsdom": "^31.0.1",
    "localforage": "^1.10.0",
    "publint": "^0.3.25",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.1.0"
  }
}
